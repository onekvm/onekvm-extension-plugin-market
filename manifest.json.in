{
  "manifest_version": 1,
  "id": "plugin-marketplace",
  "i18n": {
    "default": {
      "name": "Plugin marketplace",
      "description": "Install plugins from package sources, and manage custom package sources."
    },
    "zh": {
      "name": "插件市场",
      "description": "从软件源安装插件，并管理自定义软件包源。"
    },
    "zh-TW": {
      "name": "外掛市場",
      "description": "從軟體源安裝外掛，並管理自訂軟體包源。"
    }
  },
  "version": "@VERSION@",
  "api_version": 2,
  "architecture": "@ARCH@",
  "kind": "service",
  "author": "OneKVM",
  "homepage": "https://github.com/onekvm/onekvm-extension-plugin-market",
  "permissions": ["opkg-admin"],
  "capabilities": [],
  "default_enabled": true,
  "icon": {"source": "lucide", "name": "store"},
  "page": {
    "title": "Plugin marketplace",
    "renderer": "vue",
    "entrypoint": "web/page.js",
    "icon": {"source": "lucide", "name": "store"}
  },
  "shell": {
    "entrypoint": "web/shell.js"
  },
  "methods": [
    {
      "name": "list_packages",
      "command": ["bin/onekvm-plugin-marketplace", "list-packages"],
      "available_when_disabled": true,
      "timeout_seconds": 30
    },
    {
      "name": "install_package",
      "command": ["bin/onekvm-plugin-marketplace", "install-package"],
      "available_when_disabled": true,
      "timeout_seconds": 30
    },
    {
      "name": "install_progress",
      "command": ["bin/onekvm-plugin-marketplace", "install-progress"],
      "available_when_disabled": true,
      "timeout_seconds": 5
    },
    {
      "name": "remove_package",
      "command": ["bin/onekvm-plugin-marketplace", "remove-package"],
      "available_when_disabled": true,
      "timeout_seconds": 30
    },
    {
      "name": "list_sources",
      "command": ["bin/onekvm-plugin-marketplace", "list-sources"],
      "available_when_disabled": true,
      "timeout_seconds": 5
    },
    {
      "name": "set_source",
      "command": ["bin/onekvm-plugin-marketplace", "set-source"],
      "available_when_disabled": true,
      "timeout_seconds": 5
    },
    {
      "name": "set_source_enabled",
      "command": ["bin/onekvm-plugin-marketplace", "set-source-enabled"],
      "available_when_disabled": true,
      "timeout_seconds": 5
    },
    {
      "name": "remove_source",
      "command": ["bin/onekvm-plugin-marketplace", "remove-source"],
      "available_when_disabled": true,
      "timeout_seconds": 5
    }
  ],
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "service_enabled": {
        "type": "boolean",
        "title": "Background service",
        "default": false,
        "readOnly": true,
        "i18n": {
          "default": "Background service",
          "zh": "后台服务",
          "zh-TW": "背景服務"
        }
      }
    }
  },
  "secret_fields": [],
  "memory_budget": "1M",
  "resource_limits": {
    "memory_max": "16M",
    "cpu_quota": "15%",
    "tasks_max": 8,
    "limit_nofile": 64
  },
  "healthcheck": {
    "type": "exec",
    "command": ["bin/onekvm-plugin-marketplace", "--health"],
    "timeout_seconds": 5
  }
}
